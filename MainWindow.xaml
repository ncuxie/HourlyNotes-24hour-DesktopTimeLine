<Window x:Class="HourlyNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="当日时间轴"
        Width="430" Height="470" MinWidth="360" MinHeight="460"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FF444444"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#F2FFFFFF" CornerRadius="10"
            BorderBrush="#55000000" BorderThickness="1" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶栏：拖拽移动 + 回到当前 + 齿轮 + 关闭 -->
            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="当日时间轴" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="BtnNow" Content="回到当前" Click="BtnNow_Click"
                            Style="{StaticResource HeaderButton}"/>
                    <Button x:Name="BtnGear" Content="⚙" Click="BtnGear_Click"
                            Style="{StaticResource HeaderButton}" Width="30"/>
                    <Button Content="✕" Click="BtnClose_Click"
                            Style="{StaticResource HeaderButton}" Width="30"/>
                </StackPanel>

                <!-- 透明度设置弹层 -->
                <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=BtnGear}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="White" CornerRadius="6" Padding="12"
                            BorderBrush="#DDDDDD" BorderThickness="1">
                        <StackPanel Width="180">
                            <TextBlock Text="窗口透明度" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Slider x:Name="OpacitySlider" Minimum="0.35" Maximum="1.0"
                                    Value="1.0" ValueChanged="OpacitySlider_ValueChanged"/>
                            <TextBlock x:Name="OpacityValue" Text="100%"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"
                                       Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- 24 小时列表 -->
            <ListBox x:Name="HourList" Grid.Row="1"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.CanContentScroll="False"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     PreviewMouseWheel="HourList_PreviewMouseWheel">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="#22000000"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Background" Value="#33FFC107"/>
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="48">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding TimeLabel}" Foreground="#FF666666"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Margin="0,14,10,0" FontSize="12"/>

                            <Grid Grid.Column="1" Background="Transparent"
                                  MouseLeftButtonDown="Cell_MouseLeftButtonDown">
                                <TextBlock x:Name="DisplayText" Text="{Binding Text}"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text}" VerticalAlignment="Center"
                                           Margin="4,4,8,4" LineHeight="18"/>
                                <TextBox x:Name="EditBox" Visibility="Collapsed"
                                         TextWrapping="Wrap" AcceptsReturn="False"
                                         BorderBrush="#FF0078D4" BorderThickness="1"
                                         Margin="2,4,6,4" VerticalContentAlignment="Center"
                                         KeyDown="EditBox_KeyDown" LostFocus="EditBox_LostFocus"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ResizeGrip Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Width="14" Height="14" Background="Transparent" IsTabStop="False"/>
        </Grid>
    </Border>
</Window>
